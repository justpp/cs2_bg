<Window x:Class="Cs2VoiceMusic.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 语音放歌助手"
        Width="880" Height="720"
        MinWidth="760" MinHeight="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 主开关 -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CS2 语音放歌助手" Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="StatusText" Text="未启动" Style="{StaticResource DimText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1" x:Name="RunStateBadge" Background="{StaticResource PanelAltBrush}"
                        CornerRadius="12" Padding="12,5" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="RunStateText" Text="已停止" FontSize="12" />
                </Border>

                <Button Grid.Column="2" x:Name="StartStopButton" Content="启动混音"
                        Style="{StaticResource PrimaryButton}" Width="110"
                        VerticalAlignment="Center" Click="StartStop_Click" />
            </Grid>
        </Border>

        <!-- 主体：Tab -->
        <TabControl Grid.Row="1" x:Name="MainTabs" Background="Transparent"
                    BorderThickness="0" Margin="12,10,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Background="Transparent" Padding="16,8"
                                        CornerRadius="6" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{StaticResource PanelAltBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ============ 概览 ============ -->
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <!-- 当前歌曲 -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6"
                                        Background="{StaticResource PanelAltBrush}" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconNote}" Fill="{StaticResource AccentBrush}"
                                          Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NowPlayingTitle" Text="QQ 音乐未在播放"
                                               Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NowPlayingArtist" Text="—"
                                               Style="{StaticResource DimText}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Width="40" Padding="0,6" Margin="0,0,6,0" Click="Prev_Click"
                                            ToolTip="上一首">
                                        <Path Data="{StaticResource IconPrev}" Style="{StaticResource IconShape}" />
                                    </Button>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}"
                                            Width="46" Padding="0,6" Margin="0,0,6,0" Click="PlayPause_Click"
                                            ToolTip="播放 / 暂停">
                                        <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}"
                                              Style="{StaticResource IconShapeOnAccent}" />
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Width="40" Padding="0,6" Click="Next_Click" ToolTip="下一首">
                                        <Path Data="{StaticResource IconNext}" Style="{StaticResource IconShape}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 注入开关 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="音乐注入" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="开启后，队友能从语音里听到 QQ 音乐；关闭时只传你的麦克风。"
                                                   Style="{StaticResource DimText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="InjectToggle" Width="56" Height="30"
                                                  VerticalAlignment="Center" Click="InjectToggle_Click"
                                                  Style="{StaticResource SwitchToggle}" />
                                </Grid>

                                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="麦克风直通" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="关闭后队友完全听不到你，只剩音乐。"
                                                   Style="{StaticResource DimText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="MicToggle" Width="56" Height="30"
                                                  VerticalAlignment="Center" Click="MicToggle_Click"
                                                  Style="{StaticResource SwitchToggle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 电平表 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="实时电平" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="麦克风" Style="{StaticResource DimText}"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Height="14">
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" />
                                        <Border x:Name="MicLevelBar" HorizontalAlignment="Left"
                                                Background="{StaticResource GoodBrush}" CornerRadius="7"
                                                Width="0" />
                                    </Grid>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="音乐" Style="{StaticResource DimText}"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Height="14">
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" />
                                        <Border x:Name="MusicLevelBar" HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}" CornerRadius="7"
                                                Width="0" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 诊断 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行诊断" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                                <TextBlock x:Name="DiagnosticText" Style="{StaticResource DimText}"
                                           TextWrapping="Wrap" LineHeight="20" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 设备 ============ -->
            <TabItem Header="设备">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="输出到（虚拟声卡）" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="选择虚拟声卡的“播放”端。CS2 里把麦克风选成同一张虚拟声卡的“录音”端。" />
                                <ComboBox x:Name="OutputDeviceCombo" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="麦克风来源" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="你的真实麦克风。选择“不使用”则只传音乐。" />
                                <ComboBox x:Name="MicDeviceCombo" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="QQ 音乐进程名" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="按顺序匹配，逗号分隔。一般保持默认即可。" />
                                <TextBox x:Name="ProcessNamesBox" />
                                <TextBlock x:Name="ProcessStatusText" Style="{StaticResource DimText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Content="重新扫描设备" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="RefreshDevices_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 音乐槽位 ============ -->
            <TabItem Header="音乐槽位">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="按快捷键，直接放指定的歌" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           LineHeight="20"
                                           Text="给 4 个槽位各绑定若干音频文件。游戏中按 Ctrl+Alt+1~4，就能立刻切到对应的歌。每个槽位对应一个快捷键，可在「快捷键」页修改。" />
                            </StackPanel>
                        </Border>

                        <!-- 四个槽位卡片，由代码动态填充 -->
                        <StackPanel x:Name="SlotPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 快捷键 ============ -->
            <TabItem Header="快捷键">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource DimText}" Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="点击右侧的按键框后，直接按下想用的组合键。建议用 Ctrl+Alt 开头，避免和游戏内按键冲突。" />

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HotkeyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ActionName}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{Binding DisplayText}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding}" Click="HotkeyCapture_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="恢复默认" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="ResetHotkeys_Click" />
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource DimText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 帮助 ============ -->
            <TabItem Header="配置指引">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="三步让音乐进语音" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
                                <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextBrush}">
                                    1. 安装一张虚拟声卡（推荐 VB-Audio Virtual Cable，免费）。<LineBreak/>
                                    2. 在本程序「设备」页，输出选虚拟声卡的播放端，麦克风选你的真实麦克风。<LineBreak/>
                                    3. 在 CS2 里把「音频 → 语音」的输入设备，选成虚拟声卡的录音端。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="为什么要虚拟声卡" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="22">
                                    CS2 只能从一张“麦克风”设备取声音。虚拟声卡的作用是提供一张可以被写入的“麦克风”：
                                    本程序把「你的麦克风 + QQ 音乐」混好后写进去，CS2 再把它当成麦克风读出来，
                                    于是队友就同时听到了你说话和音乐。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="常见问题" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="22">
                                    · 队友听不到音乐：确认「音乐注入」是开着的，且诊断里音乐电平在动。<LineBreak/>
                                    · 队友听到的是游戏音效：说明输出设备选错了，应该选虚拟声卡而不是扬声器。<LineBreak/>
                                    · 自己听不到音乐：虚拟声卡不会把声音送到耳机。请在 QQ 音乐里同时保持正常输出，
                                    或使用 VB-Cable 的监听功能。<LineBreak/>
                                    · 音乐有杂音/断续：把虚拟声卡采样率调到 48000 Hz（Windows 声音设置 → 属性 → 高级）。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="重要提醒" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource WarnBrush}" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="22">
                                    在竞技对局里向队友播放音乐可能影响沟通，请只在休闲、朋友局或征得队友同意时使用。
                                    本程序不修改游戏文件、不注入游戏进程，仅通过系统标准音频与媒体接口工作。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterHint" Style="{StaticResource DimText}"
                           VerticalAlignment="Center"
                           Text="关闭窗口后程序会继续在托盘运行" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="Save_Click" />
                    <Button Content="隐藏到托盘" Style="{StaticResource SecondaryButton}"
                            Click="Hide_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
